---
interface Props {
  siteTitle: string
}

const { siteTitle } = Astro.props
---

<header class="topbar" data-topbar>
  <a href="/" class="wordmark" data-wordmark aria-label={`${siteTitle} — início`}>
    {
      siteTitle
        .split("")
        .map((ch) => (ch === "." ? <span class="accent">.</span> : ch))
    }
  </a>
  <div class="topbar-side">
    <button class="theme-btn" type="button" data-theme-toggle aria-label="Alternar tema">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        ></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
        <path
          d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
    <button class="search-btn mono" type="button" data-palette-open aria-label="Abrir busca (Cmd+K)">
      <span class="knob-dial" aria-hidden="true"></span>
      <span>buscar</span>
      <kbd>⌘k</kbd>
    </button>
  </div>
</header>
